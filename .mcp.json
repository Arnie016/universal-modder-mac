{
  "mcpServers": {
    "fal": {
      "type": "http",
      "url": "https://mcp.fal.ai/mcp",
      "headers": {
        "Authorization": "Bearer ${FAL_KEY}"
      }
    },
    "mashup-scout": {
      "command": "${CLAUDE_PLUGIN_ROOT:-.}/bin/um",
      "args": [
        "scout",
        "mcp"
      ]
    }
  }
}
